# Example configuration for Instagram Scraper with Groq (Fast & Free!)
# Copy this file to .env and update with your actual credentials

# ===== AI Configuration (Groq - RECOMMENDED) =====
# Groq is FAST and has a generous free tier
# Sign up: https://console.groq.com/
AI_PROVIDER=groq
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile
MIN_AI_CONFIDENCE=0.7

# IMPORTANT: Use correct Groq model names! (Updated January 2025)
# Available Groq models (all free):
# - llama-3.3-70b-versatile (recommended - best quality, best for batch)
# - llama-3.1-8b-instant (very fast, good for quick tests)
# - mixtral-8x7b-32768 (good balance)
# - gemma2-9b-it (lightweight)

# See all models: https://console.groq.com/docs/models

# ⚠️ DO NOT USE: "groq/compound" or "llama-3.1-70b-versatile" (decommissioned)
# If you see these in your config, change to one of the models above

# ===== Apify Configuration =====
APIFY_TOKEN=apify_api_your_token_here
APIFY_ACTOR_ID=shu8hvrXbJbY3Eb9W

# ===== Instagram Sources =====
# Ukrainian concert/event accounts
INSTAGRAM_ACCOUNTS=concert_ua,kyivmusicevents,atlas37,live_kyiv,caribbean_club_kiev,originstage

# Optional: Add hashtags
# INSTAGRAM_HASHTAGS=kyivconcerts,концертиукраїна

# Optional: Add locations (location IDs)
# INSTAGRAM_LOCATIONS=183918115737714

# ===== Processing Settings =====
RESULTS_LIMIT=200
SAVE_OUTPUT=true
OUTPUT_FILE=instagram-posts.json

# ===== RabbitMQ Configuration =====
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
RABBITMQ_QUEUE=events
PUBLISHER_BATCH_SIZE=50
PUBLISHER_BATCH_INTERVAL_MS=200

# ===== Scheduler (optional) =====
SCRAPER_CRON=0 */3 * * *

# ===== Telegram Notifications (optional) =====
# TELEGRAM_TRACKER_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# ===== Groq Benefits =====
# ✅ Fast: Fastest inference in the world
# ✅ Free: 30 requests/minute free tier
# ✅ Quality: Llama 3.1 70B is very good
# ✅ Batch mode: Process 200 posts in 1 request!
