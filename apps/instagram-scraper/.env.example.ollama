# Example configuration for Instagram Scraper with Local Ollama
# Copy this file to .env and update with your actual credentials

# ===== AI Configuration (Ollama - Local, Free) =====
AI_PROVIDER=ollama
# No API key needed for Ollama
AI_MODEL=llama3.2
MIN_AI_CONFIDENCE=0.6  # Lower confidence for local models

# Note: Ollama must be running locally
# Install: https://ollama.com
# Pull model: ollama pull llama3.2
# Verify: curl http://localhost:11434/api/tags

# ===== Apify Configuration =====
APIFY_TOKEN=apify_api_your_token_here
APIFY_ACTOR_ID=shu8hvrXbJbY3Eb9W

# ===== Instagram Sources =====
# Ukrainian concert/event accounts
INSTAGRAM_ACCOUNTS=concert_ua,kyivmusicevents,atlas37

# ===== Processing Settings =====
RESULTS_LIMIT=50  # Start with fewer posts for local AI
SAVE_OUTPUT=true
OUTPUT_FILE=instagram-posts.json

# ===== RabbitMQ Configuration =====
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
RABBITMQ_QUEUE=events
PUBLISHER_BATCH_SIZE=25
PUBLISHER_BATCH_INTERVAL_MS=500  # Slower for local processing

# ===== Scheduler (optional) =====
SCRAPER_CRON=0 */6 * * *  # Every 6 hours for local AI

# ===== Telegram Notifications (optional) =====
# TELEGRAM_TRACKER_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id