# ===== REQUIRED CONFIGURATION =====

# Apify Configuration (for fetching Instagram posts)
APIFY_TOKEN=your_apify_token_here
APIFY_ACTOR_ID=shu8hvrXbJbY3Eb9W

# AI Provider Configuration (for extracting events from posts)
AI_PROVIDER=groq                # Options: groq (recommended, fast & free), openai, claude, ollama (local)
AI_API_KEY=your_api_key_here    # Required for groq/openai/claude, not needed for ollama

# Instagram Sources (at least one required)
INSTAGRAM_ACCOUNTS=concert_ua,kyivmusicevents,atlas37
# INSTAGRAM_HASHTAGS=kyivconcerts,ukraineevents
# INSTAGRAM_LOCATIONS=183918115737714

# ===== OPTIONAL CONFIGURATION =====

# AI Model Selection
AI_MODEL=llama-3.3-70b-versatile  # For Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# AI_MODEL=gpt-4o-mini             # For OpenAI: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# AI_MODEL=claude-3-haiku-20240307 # For Claude: claude-3-opus, claude-3-sonnet, claude-3-haiku
# AI_MODEL=llama3.2                # For Ollama: llama3.2, mistral, mixtral

# Quality Control
MIN_AI_CONFIDENCE=0.7          # Minimum confidence score (0-1) to accept an event

# Results Configuration
RESULTS_LIMIT=200               # Max posts to fetch per account
SAVE_OUTPUT=false               # Save raw posts and events to JSON files
OUTPUT_FILE=instagram-posts.json

# Scheduler (cron expression)
SCRAPER_CRON=0 */3 * * *       # Default: every 3 hours

# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
RABBITMQ_QUEUE=events
PUBLISHER_BATCH_SIZE=50
PUBLISHER_BATCH_INTERVAL_MS=200

# Telegram Notifications (optional)
TELEGRAM_TRACKER_TOKEN=
TELEGRAM_CHAT_ID=

# ===== EXAMPLES FOR DIFFERENT AI PROVIDERS =====

# Example 1: Using Groq (RECOMMENDED - Fast & Free)
# AI_PROVIDER=groq
# AI_API_KEY=gsk-xxxxx
# AI_MODEL=llama-3.3-70b-versatile
# Get key: https://console.groq.com/

# Example 2: Using OpenAI (Paid, High Quality)
# AI_PROVIDER=openai
# AI_API_KEY=sk-proj-xxxxx
# AI_MODEL=gpt-4o-mini

# Example 3: Using Claude (Paid, Alternative)
# AI_PROVIDER=claude
# AI_API_KEY=sk-ant-xxxxx
# AI_MODEL=claude-3-haiku-20240307

# Example 4: Using Local Ollama (Free, but less accurate)
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# Note: Requires Ollama running locally on http://localhost:11434