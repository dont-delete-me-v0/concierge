# Example configuration for Instagram Scraper with OpenAI
# Copy this file to .env and update with your actual credentials

# ===== AI Configuration (OpenAI) =====
AI_PROVIDER=openai
AI_API_KEY=sk-proj-your_openai_api_key_here
AI_MODEL=gpt-4o-mini
MIN_AI_CONFIDENCE=0.7

# ===== Apify Configuration =====
APIFY_TOKEN=apify_api_your_token_here
APIFY_ACTOR_ID=shu8hvrXbJbY3Eb9W

# ===== Instagram Sources =====
# Ukrainian concert/event accounts
INSTAGRAM_ACCOUNTS=concert_ua,kyivmusicevents,atlas37,live_kyiv,caribbean_club_kiev

# ===== Processing Settings =====
RESULTS_LIMIT=100
SAVE_OUTPUT=true
OUTPUT_FILE=instagram-posts.json

# ===== RabbitMQ Configuration =====
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
RABBITMQ_QUEUE=events
PUBLISHER_BATCH_SIZE=50
PUBLISHER_BATCH_INTERVAL_MS=200

# ===== Scheduler (optional) =====
SCRAPER_CRON=0 */3 * * *

# ===== Telegram Notifications (optional) =====
# TELEGRAM_TRACKER_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id