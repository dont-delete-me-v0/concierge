# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=concierge
POSTGRES_PORT=5432

# PostgreSQL connection URL for local development
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/concierge"

# ===========================================
# PGADMIN CONFIGURATION
# ===========================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=5050

# ===========================================
# RABBITMQ CONFIGURATION
# ===========================================
# RabbitMQ connection for local development
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
RABBITMQ_QUEUE=events
RABBITMQ_PREFETCH=100

# Consumer configuration
CONSUMER_BATCH_SIZE=100
CONSUMER_FLUSH_MS=200

# Publisher configuration
PUBLISHER_BATCH_SIZE=50
PUBLISHER_BATCH_INTERVAL_MS=200
PUBLISHER_MAX_RETRIES=3
PUBLISHER_RECONNECT_DELAY_MS=1000

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Redis connection for local development
REDIS_URL=redis://localhost:6379

# ===========================================
# TELEGRAM BOT CONFIGURATION
# ===========================================
# Main bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Tracker bot token for notifications (optional)
TELEGRAM_TRACKER_TOKEN=your_tracker_bot_token_here

# Chat ID for notifications (used by tracker)
TELEGRAM_CHAT_ID=your_chat_id_here

# Enable/disable Telegram tracking notifications
TELEGRAM_TRACKING=true

# Daily digest cron schedule (default: 8:00 AM every day)
DIGEST_CRON=0 8 * * *

# ===========================================
# API CONFIGURATION
# ===========================================
API_BASE_URL=http://localhost:3000

# ===========================================
# WEB CRAWLER CONFIGURATION
# ===========================================
# Cron schedule for web crawler (default: every 3 hours)
# Format: minute hour day month weekday
CRAWLER_SCHEDULE=0 */3 * * *

# Directory containing crawler configurations
CONFIG_DIR=crawl-configs

# Redis key prefix for crawler state
STATE_PREFIX=concert.ua

# Save crawler output to JSON files (true/false)
CRAWLER_SAVE_OUTPUT=false

# Base URL for the source website
SOURCE_BASE_URL=https://concert.ua

# ===========================================
# INSTAGRAM SCRAPER CONFIGURATION
# ===========================================
# Apify API token (required for Instagram scraping)
# Get your token from: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Apify actor ID for Instagram scraper
# Default: apify/instagram-profile-scraper
APIFY_ACTOR_ID=shu8hvrXbJbY3Eb9W

# Instagram accounts to scrape (comma-separated usernames)
INSTAGRAM_ACCOUNTS=kontramarka.ua,concert_ua

# Instagram hashtags to search (comma-separated, optional)
INSTAGRAM_HASHTAGS=kyivevents,kyivconcert,kyivparty

# Instagram locations to search (comma-separated location IDs, optional)
# Example: 183918115737714 (Kyiv)
INSTAGRAM_LOCATIONS=

# Maximum posts to fetch per source
RESULTS_LIMIT=50

# Save Instagram scraper output to JSON files (true/false)
SAVE_OUTPUT=false

# Output file name for Instagram scraper
OUTPUT_FILE=instagram-posts.json

# Scheduler cron expression (default: every 3 hours)
SCRAPER_CRON=0 */3 * * *

# ===========================================
# AI EXTRACTION CONFIGURATION
# ===========================================
# AI provider: openai | anthropic | google | groq
AI_PROVIDER=openai

# API key for the selected AI provider
# - For OpenAI: Get from https://platform.openai.com/api-keys
# - For Anthropic: Get from https://console.anthropic.com/
# - For Google: Get from https://makersuite.google.com/app/apikey
# - For Groq: Get from https://console.groq.com/keys
AI_API_KEY=your_ai_api_key_here

# AI model to use (optional, uses provider default if not set)
# Examples:
# - OpenAI: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# - Google: gemini-1.5-pro, gemini-1.5-flash
# - Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768
AI_MODEL=

# Minimum confidence score for event extraction (0.0-1.0)
# Events below this threshold will be filtered out
MIN_AI_CONFIDENCE=0.7
