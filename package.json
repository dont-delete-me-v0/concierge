{
  "name": "concierge",
  "version": "1.0.0",
  "description": "Concierge monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter bot start:dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\"",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "test": "pnpm -r test",
    "bot": "pnpm --filter bot start",
    "api": "pnpm --filter api start",
    "crawler": "pnpm --filter web-crawler start",
    "instagram": "pnpm --filter instagram-scraper start",
    "prisma:generate": "pnpm --filter @concierge/database exec prisma generate",
    "prisma:migrate": "pnpm --filter @concierge/database exec prisma migrate deploy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.2",
  "dependencies": {
    "@prisma/client": "^6.17.1"
  }
}
